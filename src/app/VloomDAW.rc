// Windows resources: the icon Explorer, the taskbar and Alt+Tab show.
// Index 0 (IDI_ICON1) is the executable's icon; index 1 (IDI_PROJECT_ICON) is
// the .vloom project document icon shown in Windows Explorer.
IDI_ICON1        ICON "../../resources/app/vloomdaw.ico"
IDI_PROJECT_ICON ICON "../../resources/app/vloom-project.ico"
